#!/bin/bash
set -euo pipefail
exec > /var/log/monitoring-init.log 2>&1

REGION="${region}"
CLUSTER_NAME="${cluster_name}"
SECRET_NAME="${grafana_admin_secret_name}"
MONITORING_BASIC_AUTH_SECRET_NAME="${monitoring_basic_auth_secret_name}"
SMTP_SECRET_NAME="${alertmanager_smtp_secret_name}"
NE_PORT="${ne_port}"

# ── Install Docker + tools ────────────────────────────────────────────────────
# docker-compose-plugin isn't in Ubuntu's default repos, only Docker's own.
# See TROUBLESHOOTING.md OBS-033. apache2-utils is for htpasswd, used below
# to bcrypt-hash the Prometheus/Alertmanager basic-auth password -- both
# tools' --web.config.file format requires a bcrypt hash, not plaintext.
apt-get update -y
apt-get install -y ca-certificates curl gnupg jq awscli apache2-utils
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
chmod a+r /etc/apt/keyrings/docker.asc
ARCH=$(dpkg --print-architecture)
CODENAME=$(. /etc/os-release && echo "$VERSION_CODENAME")
echo "deb [arch=$ARCH signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $CODENAME stable" > /etc/apt/sources.list.d/docker.list
apt-get update -y
apt-get install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin
systemctl enable docker
systemctl start docker

# Docker's own apt repo (unlike docker.io) never adds a user to the docker
# group. See TROUBLESHOOTING.md OBS-041.
usermod -aG docker ubuntu

# ── Install kubectl ───────────────────────────────────────────────────────────
KUBECTL_VER="v1.31.0"
curl -sL "https://dl.k8s.io/release/$${KUBECTL_VER}/bin/linux/amd64/kubectl" \
  -o /usr/local/bin/kubectl
chmod +x /usr/local/bin/kubectl

# ── Directory structure ───────────────────────────────────────────────────────
mkdir -p /opt/monitoring/{prometheus/{targets,rules},grafana/provisioning/{datasources,dashboards},loki}

# ── Grafana admin password from Secrets Manager ───────────────────────────────
# Retried: this instance's IAM role policy is created in the same apply as
# the instance itself, and IAM changes aren't instantly consistent -- the
# very first boot can hit this call before the policy has propagated.
# Confirmed live: AccessDeniedException on secretsmanager:GetSecretValue
# immediately after boot, same call succeeding seconds later with zero
# config changes. Under set -e this killed the rest of the script (and so
# the entire monitoring stack -- nothing after this line ever ran) with no
# automatic retry, since user-data only runs once. See OBS-050.
GRAFANA_PASSWORD=""
for i in $(seq 1 20); do
  GRAFANA_PASSWORD=$(aws secretsmanager get-secret-value \
    --secret-id "$SECRET_NAME" \
    --region "$REGION" \
    --query SecretString \
    --output text 2>/dev/null) && break
  echo "Waiting for IAM policy propagation before retrying secretsmanager get-secret-value (attempt $i)..."
  sleep 6
done
if [ -z "$GRAFANA_PASSWORD" ]; then
  echo "FATAL: could not fetch $SECRET_NAME after 20 attempts" >&2
  exit 1
fi

# Write to temp file so background dashboard importer can read it
echo "$GRAFANA_PASSWORD" > /run/grafana-pass
chmod 600 /run/grafana-pass

# ── Prometheus/Alertmanager basic-auth password from Secrets Manager ──────────
# Same IAM-propagation race as the Grafana password above -- same retry loop.
# Neither tool ships with its own auth; without this they're wide open to
# anyone in admin_cidr_blocks with zero login required (see TROUBLESHOOTING.md
# OBS-063). htpasswd bcrypt-hashes it below for each tool's --web.config.file;
# Grafana's own datasource config gets the plaintext so its dashboard queries
# (which go over this same auth now, not the public internet) keep working.
MONITORING_BASIC_AUTH_PASSWORD=""
for i in $(seq 1 20); do
  MONITORING_BASIC_AUTH_PASSWORD=$(aws secretsmanager get-secret-value \
    --secret-id "$MONITORING_BASIC_AUTH_SECRET_NAME" \
    --region "$REGION" \
    --query SecretString \
    --output text 2>/dev/null) && break
  echo "Waiting for IAM policy propagation before retrying secretsmanager get-secret-value (attempt $i)..."
  sleep 6
done
if [ -z "$MONITORING_BASIC_AUTH_PASSWORD" ]; then
  echo "FATAL: could not fetch $MONITORING_BASIC_AUTH_SECRET_NAME after 20 attempts" >&2
  exit 1
fi
MONITORING_BASIC_AUTH_HASH=$(htpasswd -nbBC 10 admin "$MONITORING_BASIC_AUTH_PASSWORD" | cut -d: -f2)

# ── Alertmanager SES SMTP credentials from Secrets Manager ────────────────────
# Same IAM-propagation race as the Grafana password above -- same retry loop.
SMTP_SECRET_JSON=""
for i in $(seq 1 20); do
  SMTP_SECRET_JSON=$(aws secretsmanager get-secret-value \
    --secret-id "$SMTP_SECRET_NAME" \
    --region "$REGION" \
    --query SecretString \
    --output text 2>/dev/null) && break
  echo "Waiting for IAM policy propagation before retrying secretsmanager get-secret-value for $SMTP_SECRET_NAME (attempt $i)..."
  sleep 6
done
if [ -z "$SMTP_SECRET_JSON" ]; then
  echo "FATAL: could not fetch $SMTP_SECRET_NAME after 20 attempts" >&2
  exit 1
fi
SMTP_HOST=$(echo "$SMTP_SECRET_JSON" | jq -r .SMTP_HOST)
SMTP_PORT=$(echo "$SMTP_SECRET_JSON" | jq -r .SMTP_PORT)
SMTP_USERNAME=$(echo "$SMTP_SECRET_JSON" | jq -r .SMTP_USERNAME)
SMTP_PASSWORD=$(echo "$SMTP_SECRET_JSON" | jq -r .SMTP_PASSWORD)
SMTP_FROM=$(echo "$SMTP_SECRET_JSON" | jq -r .SMTP_FROM)
SMTP_TO=$(echo "$SMTP_SECRET_JSON" | jq -r .SMTP_TO)

# ── kubeconfig for kube-state-metrics Docker container ───────────────────────
# /opt/monitoring/kube, not /root/.kube (0700, blocks the container's
# non-root user). Static bearer token refreshed by cron. See OBS-033.
# Restarts kube-state-metrics on every refresh -- it loads the kubeconfig
# once at start and never re-reads it, so a stale token otherwise sticks
# forever. See OBS-042. `|| true`: first run predates the container existing.
mkdir -p /opt/monitoring/kube
cat > /usr/local/bin/refresh-kube-token.sh << REFRESH_EOF
#!/bin/bash
set -euo pipefail
REGION="$REGION"
CLUSTER_NAME="$CLUSTER_NAME"
ENDPOINT=\$(aws eks describe-cluster --region "\$REGION" --name "\$CLUSTER_NAME" --query cluster.endpoint --output text)
CA=\$(aws eks describe-cluster --region "\$REGION" --name "\$CLUSTER_NAME" --query cluster.certificateAuthority.data --output text)
TOKEN=\$(aws eks get-token --region "\$REGION" --cluster-name "\$CLUSTER_NAME" --output json | python3 -c "import json,sys; print(json.load(sys.stdin)['status']['token'])")
cat > /opt/monitoring/kube/config << CONF_EOF
apiVersion: v1
kind: Config
clusters:
- cluster:
    server: \$ENDPOINT
    certificate-authority-data: \$CA
  name: \$CLUSTER_NAME
contexts:
- context:
    cluster: \$CLUSTER_NAME
    user: \$CLUSTER_NAME
  name: \$CLUSTER_NAME
current-context: \$CLUSTER_NAME
users:
- name: \$CLUSTER_NAME
  user:
    token: \$TOKEN
CONF_EOF
chmod 644 /opt/monitoring/kube/config
docker restart kube-state-metrics || true

# Plain token file for Prometheus's kubelet scrape job (bearer_token_file) --
# Prometheus re-reads this on every scrape, no restart needed.
echo -n "\$TOKEN" > /opt/monitoring/kube/token
chmod 644 /opt/monitoring/kube/token
REFRESH_EOF
chmod +x /usr/local/bin/refresh-kube-token.sh
/usr/local/bin/refresh-kube-token.sh
echo "*/10 * * * * root /usr/local/bin/refresh-kube-token.sh" > /etc/cron.d/kube-token-refresh

# ── Node-discovery script (cron updates Prometheus file_sd targets) ───────────
# Terraform substitutes ${region}, ${cluster_name}, ${ne_port} at apply time
# so the written script has hardcoded values — no env vars needed at runtime.
cat > /usr/local/bin/update-prom-targets.sh << 'SCRIPT_EOF'
#!/bin/bash
REGION="${region}"
CLUSTER_NAME="${cluster_name}"
NE_PORT="${ne_port}"
KUBELET_PORT="${kubelet_port}"

# "<ip> <nodegroup>" per line. nodegroup lets the chaos (Spot) node group
# alert at warning instead of critical (ChaosNodeDown vs NodeDown).
NODES=$(aws ec2 describe-instances \
  --region "$REGION" \
  --filters \
    "Name=tag:eks:cluster-name,Values=$CLUSTER_NAME" \
    "Name=instance-state-name,Values=running" \
  --query 'Reservations[*].Instances[*].[PrivateIpAddress, Tags[?Key==`eks:nodegroup-name`]|[0].Value]' \
  --output text)

build_json() {
  local port=$1
  printf '['
  echo "$NODES" | {
    first=true
    while read -r ip ng; do
      [ -z "$ip" ] && continue
      [ "$first" = "false" ] && printf ','
      printf '{"targets":["%s:%s"],"labels":{"cluster":"%s","nodegroup":"%s"}}' \
        "$ip" "$port" "$CLUSTER_NAME" "$ng"
      first=false
    done
  }
  printf ']'
}

build_json "$NE_PORT" > /opt/monitoring/prometheus/targets/ne.json
build_json "$KUBELET_PORT" > /opt/monitoring/prometheus/targets/kubelet.json
SCRIPT_EOF

chmod +x /usr/local/bin/update-prom-targets.sh
/usr/local/bin/update-prom-targets.sh

# Refresh every 5 minutes (handles node replacements / scale events)
echo "*/5 * * * * root /usr/local/bin/update-prom-targets.sh" > /etc/cron.d/prom-targets

# Prometheus's own basic-auth password, as a file Prometheus's config can
# point `password_file` at (OBS-063) -- kept out of prometheus.yml itself
# (below, deliberately a QUOTED heredoc: its relabel_configs use $1/$2/$3
# regex backreferences that a bash-expanding heredoc would silently mangle,
# so the password can't be interpolated inline there the way alertmanager.yml
# does with $SMTP_* above -- a separate file sidesteps that entirely).
echo "$MONITORING_BASIC_AUTH_PASSWORD" > /opt/monitoring/prometheus/basic-auth-password
# 644, not 600: this file is bind-mounted into the Prometheus container, which
# runs as non-root (nobody). Prometheus needs to read it both for its own
# self-scrape auth AND to attach the Authorization header on every alert POST
# to Alertmanager -- with 600/root-owned it got "permission denied", the
# self-scrape target sat DOWN, and NO alert ever reached Alertmanager, so no
# notification email ever sent (OBS-071). The value is the monitoring
# basic-auth password, already in Secrets Manager and needed to hit any
# monitoring URL; on this single-tenant private box, host-readable is fine.
chmod 644 /opt/monitoring/prometheus/basic-auth-password

# ── Prometheus config ─────────────────────────────────────────────────────────
cat > /opt/monitoring/prometheus/prometheus.yml << 'PROM_EOF'
global:
  # 10s (not the usual 30-60s) so a load test shows up in rate() windows and
  # trips the demo alerts within ~2 min of load start instead of ~4-5 min.
  # Fine for this single-node Prometheus scraping ~20 targets.
  scrape_interval: 10s
  evaluation_interval: 10s

alerting:
  alertmanagers:
    - basic_auth:
        username: admin
        password_file: /etc/prometheus/basic-auth-password
      static_configs:
        - targets: ['alertmanager:9093']

rule_files:
  - "/etc/prometheus/rules/*.yml"

scrape_configs:
  - job_name: 'prometheus'
    basic_auth:
      username: admin
      password_file: /etc/prometheus/basic-auth-password
    static_configs:
      - targets: ['localhost:9090']

  - job_name: 'kube-state-metrics'
    static_configs:
      - targets: ['kube-state-metrics:8080']

  # Self-monitoring: AlertmanagerNotificationsFailing (a broken RCA webhook,
  # like OBS-076, now alerts by email) and LogIngestionStalled.
  - job_name: 'alertmanager'
    basic_auth:
      username: admin
      password_file: /etc/prometheus/basic-auth-password
    static_configs:
      - targets: ['alertmanager:9093']

  - job_name: 'loki'
    static_configs:
      - targets: ['loki:3100']

  - job_name: 'node-exporter'
    file_sd_configs:
      - files: ['/etc/prometheus/targets/ne.json']
        refresh_interval: 5m

  # Real per-pod CPU/memory usage (kube-state-metrics only has
  # requests/limits/status). bearer_token_file auto-refreshes, no restart.
  - job_name: 'kubelet-cadvisor'
    scheme: https
    tls_config:
      insecure_skip_verify: true
    bearer_token_file: /etc/prometheus/kube/token
    metrics_path: /metrics/cadvisor
    file_sd_configs:
      - files: ['/etc/prometheus/targets/kubelet.json']
        refresh_interval: 5m

  # App-level /metrics (prom-client, per-service HTTP counters/histograms).
  # Pod IPs aren't reachable from outside the cluster network, so this
  # scrapes through the API server's pod-proxy instead -- same 443 route
  # already open to the API server, no new SG rule needed. Only pods
  # annotated prometheus.io/scrape: "true" are kept (see the 6 service
  # Deployments/Rollout in k8s/services/*/base + k8s/base/backend).
  - job_name: 'app-metrics'
    scheme: https
    tls_config:
      insecure_skip_verify: true
    bearer_token_file: /etc/prometheus/kube/token
    kubernetes_sd_configs:
      - role: pod
        api_server: ${eks_api_server}
        tls_config:
          insecure_skip_verify: true
        bearer_token_file: /etc/prometheus/kube/token
    relabel_configs:
      - source_labels: [__meta_kubernetes_pod_annotation_prometheus_io_scrape]
        action: keep
        regex: "true"
      - source_labels: [__meta_kubernetes_namespace, __meta_kubernetes_pod_name, __meta_kubernetes_pod_annotation_prometheus_io_port]
        action: replace
        target_label: __metrics_path__
        regex: (.+);(.+);(.+)
        replacement: /api/v1/namespaces/$1/pods/$2:$3/proxy/metrics
      - target_label: __address__
        replacement: ${eks_api_host}
      - source_labels: [__meta_kubernetes_namespace]
        target_label: namespace
      - source_labels: [__meta_kubernetes_pod_name]
        target_label: pod
      - source_labels: [__meta_kubernetes_pod_label_app]
        target_label: app
PROM_EOF

# ── Prometheus web auth (OBS-063) ─────────────────────────────────────────────
# Unquoted heredoc: $MONITORING_BASIC_AUTH_HASH is expanded by bash at write
# time. Referenced by --web.config.file in the prometheus service below.
cat > /opt/monitoring/prometheus/web.yml << WEB_EOF
basic_auth_users:
  admin: $MONITORING_BASIC_AUTH_HASH
WEB_EOF

# ── Prometheus alerting rules ─────────────────────────────────────────────────
cat > /opt/monitoring/prometheus/rules/bookstore.yml << 'RULES_EOF'
# Full rule rationale: docs/ALERTS.md. Every pod/deployment alert gets a
# `service` label via label_replace when the pod belongs to a bookstore
# service, so the RCA can always find the right logs.
groups:
  - name: bookstore-nodes
    rules:
      - alert: NodeDown
        expr: up{job="node-exporter", nodegroup!~".*chaos.*"} == 0
        for: 3m
        labels: {severity: critical}
        annotations:
          summary: "EKS node {{ $labels.instance }} ({{ $labels.nodegroup }}) unreachable"
      - alert: ChaosNodeDown
        expr: up{job="node-exporter", nodegroup=~".*chaos.*"} == 0
        for: 3m
        labels: {severity: warning}
        annotations:
          summary: "Spot chaos node {{ $labels.instance }} unreachable (drill or Spot reclaim)"
      - alert: KubeNodeNotReady
        expr: (kube_node_status_condition{condition="Ready",status="true"} == 0) unless on(node) kube_node_labels{label_role="chaos"}
        for: 2m
        labels: {severity: critical}
        annotations:
          summary: "Node {{ $labels.node }} NotReady"
      - alert: ChaosNodeNotReady
        expr: (kube_node_status_condition{condition="Ready",status="true"} == 0) and on(node) kube_node_labels{label_role="chaos"}
        for: 2m
        labels: {severity: warning}
        annotations:
          summary: "Chaos node {{ $labels.node }} NotReady"
      - alert: KubeNodeCountDecreased
        expr: count(kube_node_info) < max_over_time(count(kube_node_info)[15m:1m])
        for: 2m
        labels: {severity: warning}
        annotations:
          summary: "Cluster lost a node: {{ $value }} nodes now (fewer than 15m ago)"
      - alert: KubeNodePressure
        expr: kube_node_status_condition{condition=~"MemoryPressure|DiskPressure|PIDPressure",status="true"} == 1
        for: 2m
        labels: {severity: warning}
        annotations:
          summary: "Node {{ $labels.node }} under {{ $labels.condition }}"
      - alert: HighCPUUsage
        expr: 100 - (avg by(instance, nodegroup) (rate(node_cpu_seconds_total{mode="idle"}[5m])) * 100) > 85
        for: 10m
        labels: {severity: warning}
        annotations:
          summary: "Node CPU {{ $value | printf \"%.1f\" }}% on {{ $labels.instance }} ({{ $labels.nodegroup }})"
      - alert: HighMemoryUsage
        expr: (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100 > 85
        for: 10m
        labels: {severity: warning}
        annotations:
          summary: "Node memory {{ $value | printf \"%.1f\" }}% on {{ $labels.instance }} ({{ $labels.nodegroup }})"
      - alert: NodeDiskSpaceLow
        expr: node_filesystem_avail_bytes{mountpoint="/",fstype!~"tmpfs|overlay"} / node_filesystem_size_bytes{mountpoint="/",fstype!~"tmpfs|overlay"} < 0.15
        for: 10m
        labels: {severity: warning}
        annotations:
          summary: "Root disk {{ $value | humanizePercentage }} free on {{ $labels.instance }}"
      - alert: NodePodCapacityHigh
        expr: count by(node) (kube_pod_info{node!=""} * on(namespace, pod) group_left() (kube_pod_status_phase{phase="Running"} == 1)) / on(node) kube_node_status_allocatable{resource="pods"} > 0.9
        for: 15m
        labels: {severity: warning}
        annotations:
          summary: "Node {{ $labels.node }} at {{ $value | humanizePercentage }} of its pod limit (t3.medium = 17)"

  - name: bookstore-workloads
    rules:
      - alert: PodCrashLooping
        expr: label_replace(increase(kube_pod_container_status_restarts_total[15m]) > 3, "service", "$1", "pod", "(api-gateway|catalog-service|user-service|order-service|notification-service)-.*")
        for: 1m
        labels: {severity: warning}
        annotations:
          summary: "{{ $labels.namespace }}/{{ $labels.pod }} restarted {{ $value | printf \"%.0f\" }}x in 15m"
      - alert: ContainerWaiting
        expr: label_replace(max by(namespace, pod, container, reason) (kube_pod_container_status_waiting_reason{reason=~"CrashLoopBackOff|ImagePullBackOff|ErrImagePull|CreateContainerConfigError|CreateContainerError|InvalidImageName"}) == 1, "service", "$1", "pod", "(api-gateway|catalog-service|user-service|order-service|notification-service)-.*")
        for: 2m
        labels: {severity: warning}
        annotations:
          summary: "{{ $labels.namespace }}/{{ $labels.pod }} stuck in {{ $labels.reason }}"
      - alert: ContainerOOMKilled
        expr: label_replace((kube_pod_container_status_last_terminated_reason{reason="OOMKilled"} == 1) and on(namespace, pod, container) (increase(kube_pod_container_status_restarts_total[10m]) > 0), "service", "$1", "pod", "(api-gateway|catalog-service|user-service|order-service|notification-service)-.*")
        labels: {severity: warning}
        annotations:
          summary: "{{ $labels.namespace }}/{{ $labels.pod }} container {{ $labels.container }} OOMKilled"
      - alert: PodNotReady
        expr: label_replace((max by(namespace, pod) (kube_pod_status_ready{condition="false"}) == 1) and on(namespace, pod) (max by(namespace, pod) (kube_pod_status_phase{phase=~"Running|Pending"}) == 1), "service", "$1", "pod", "(api-gateway|catalog-service|user-service|order-service|notification-service)-.*")
        for: 5m
        labels: {severity: warning}
        annotations:
          summary: "{{ $labels.namespace }}/{{ $labels.pod }} not Ready for 5m"
      - alert: DeploymentReplicasUnavailable
        expr: label_replace(kube_deployment_status_replicas_unavailable > 0, "service", "$1", "deployment", "(api-gateway|catalog-service|user-service|order-service|notification-service)")
        for: 5m
        labels: {severity: warning}
        annotations:
          summary: "{{ $labels.namespace }}/{{ $labels.deployment }}: {{ $value }} replica(s) unavailable"
      - alert: DeploymentDown
        expr: label_replace((kube_deployment_status_replicas_available == 0) and (kube_deployment_spec_replicas > 0), "service", "$1", "deployment", "(api-gateway|catalog-service|user-service|order-service|notification-service)")
        for: 1m
        labels: {severity: critical}
        annotations:
          summary: "{{ $labels.namespace }}/{{ $labels.deployment }} has zero available replicas"
      - alert: HPAMaxedOut
        expr: kube_horizontalpodautoscaler_status_current_replicas >= kube_horizontalpodautoscaler_spec_max_replicas
        for: 15m
        labels: {severity: warning}
        annotations:
          summary: "HPA {{ $labels.namespace }}/{{ $labels.horizontalpodautoscaler }} pinned at max replicas"
      - alert: KubeJobFailed
        expr: kube_job_status_failed > 0
        for: 1m
        labels: {severity: warning}
        annotations:
          summary: "Job {{ $labels.namespace }}/{{ $labels.job_name }} failed"
      # Demo alert driven by scripts/simulate_load.py (absolute cores, short
      # window). Control-plane namespaces excluded -- ArgoCD's controller
      # tripped it on its own (OBS-080).
      - alert: HighPodCPUUsage
        expr: sum by (namespace, pod) (rate(container_cpu_usage_seconds_total{container!="", container!="POD", namespace!~"kube-system|argocd|chaos-mesh"}[1m])) > 0.3
        for: 1m
        labels: {severity: warning}
        annotations:
          summary: "{{ $labels.namespace }}/{{ $labels.pod }} using {{ $value | printf \"%.2f\" }} cores"
      - alert: PodCPUNearLimit
        expr: label_replace(sum by(namespace, pod, container) (rate(container_cpu_usage_seconds_total{container!="", container!="POD"}[2m])) / sum by(namespace, pod, container) (kube_pod_container_resource_limits{resource="cpu"}) > 0.9, "service", "$1", "pod", "(api-gateway|catalog-service|user-service|order-service|notification-service)-.*")
        for: 3m
        labels: {severity: warning}
        annotations:
          summary: "{{ $labels.namespace }}/{{ $labels.pod }} at {{ $value | humanizePercentage }} of CPU limit"
      - alert: CPUThrottlingHigh
        expr: label_replace(sum by(namespace, pod, container) (rate(container_cpu_cfs_throttled_periods_total{container!=""}[5m])) / sum by(namespace, pod, container) (rate(container_cpu_cfs_periods_total{container!=""}[5m])) > 0.5, "service", "$1", "pod", "(api-gateway|catalog-service|user-service|order-service|notification-service)-.*")
        for: 10m
        labels: {severity: warning}
        annotations:
          summary: "{{ $labels.namespace }}/{{ $labels.pod }} throttled {{ $value | humanizePercentage }} of CFS periods"
      - alert: PodMemoryNearLimit
        expr: label_replace(sum by(namespace, pod, container) (container_memory_working_set_bytes{container!="", container!="POD"}) / sum by(namespace, pod, container) (kube_pod_container_resource_limits{resource="memory"}) > 0.9, "service", "$1", "pod", "(api-gateway|catalog-service|user-service|order-service|notification-service)-.*")
        for: 2m
        labels: {severity: warning}
        annotations:
          summary: "{{ $labels.namespace }}/{{ $labels.pod }} at {{ $value | humanizePercentage }} of memory limit"

  - name: bookstore-services
    rules:
      - alert: HighErrorRate
        expr: (sum by(service) (rate(http_requests_total{job="app-metrics", status=~"5.."}[2m])) / sum by(service) (rate(http_requests_total{job="app-metrics"}[2m])) > 0.05) and sum by(service) (rate(http_requests_total{job="app-metrics"}[2m])) > 0.05
        for: 1m
        labels: {severity: critical}
        annotations:
          summary: "{{ $labels.service }} 5xx ratio {{ $value | humanizePercentage }}"
      - alert: HighLatencyP95
        expr: (histogram_quantile(0.95, sum by(service, le) (rate(http_request_duration_seconds_bucket{job="app-metrics", route!~"/health|/metrics"}[5m]))) > 1) and sum by(service) (rate(http_request_duration_seconds_count{job="app-metrics", route!~"/health|/metrics"}[5m])) > 0.05
        for: 3m
        labels: {severity: warning}
        annotations:
          summary: "{{ $labels.service }} p95 latency {{ $value | printf \"%.2f\" }}s"
      - alert: HighRequestRate
        expr: sum by (service) (rate(http_requests_total{job="app-metrics", route!~"/health|/metrics"}[1m])) > 3
        for: 1m
        labels: {severity: warning}
        annotations:
          summary: "{{ $labels.service }} request rate {{ $value | printf \"%.1f\" }} req/s"
      - alert: ServiceTargetDown
        expr: label_replace(up{job="app-metrics", namespace=~"gateway|catalog|user|order|notification"} == 0, "service", "$1", "app", "(.+)")
        for: 3m
        labels: {severity: critical}
        annotations:
          summary: "{{ $labels.service }} pod {{ $labels.pod }} not answering /metrics"
      - alert: NotificationDispatchFailures
        expr: increase(notification_dispatch_failures_total[5m]) > 0
        labels: {severity: warning, dependency: notification-service}
        annotations:
          summary: "order-service failed {{ $value | printf \"%.0f\" }} notification dispatch(es) in 5m"
      - alert: EventLoopLagHigh
        expr: nodejs_eventloop_lag_p99_seconds{job="app-metrics"} > 0.5
        for: 5m
        labels: {severity: warning}
        annotations:
          summary: "{{ $labels.service }} event loop p99 lag {{ $value | printf \"%.2f\" }}s"

  - name: bookstore-monitoring
    rules:
      - alert: KubeStateMetricsDown
        expr: up{job="kube-state-metrics"} == 0
        for: 5m
        labels: {severity: critical}
        annotations:
          summary: "kube-state-metrics unreachable -- every Kubernetes-state alert is blind"
      - alert: ScrapeTargetDown
        expr: up{job=~"kubelet-cadvisor|alertmanager|loki"} == 0
        for: 10m
        labels: {severity: warning}
        annotations:
          summary: "{{ $labels.job }} target {{ $labels.instance }} down"
      - alert: AlertmanagerNotificationsFailing
        expr: sum by(integration) (rate(alertmanager_notifications_failed_total[5m])) > 0
        for: 5m
        labels: {severity: warning}
        annotations:
          summary: "Alertmanager {{ $labels.integration }} notifications failing (RCA webhook or email)"
      - alert: LogIngestionStalled
        expr: sum(rate(loki_distributor_lines_received_total[10m])) == 0
        for: 10m
        labels: {severity: warning}
        annotations:
          summary: "Loki received no log lines for 10m -- Fluent Bit pipeline broken"
RULES_EOF

# ── Alertmanager config ───────────────────────────────────────────────────────
mkdir -p /opt/monitoring/alertmanager

# Unquoted heredoc: SMTP_* are expanded by bash at write time (same trick as
# the LOKI_HOST/GRAFANA_PASSWORD blocks above). {{ .Status }}-style syntax
# below is Alertmanager's own Go templating, evaluated later at notification
# time, not by bash now -- no $ prefix on any of it, so bash leaves it alone.
cat > /opt/monitoring/alertmanager/alertmanager.yml << AM_EOF
global:
  resolve_timeout: 5m
  smtp_smarthost: '$SMTP_HOST:$SMTP_PORT'
  smtp_from: '$SMTP_FROM'
  smtp_auth_username: '$SMTP_USERNAME'
  smtp_auth_password: '$SMTP_PASSWORD'
  smtp_require_tls: true

route:
  receiver: 'default-webhook'
  # One notification per affected service/pod/node, not one per alertname:
  # the RCA Lambda analyzes alerts[0] of each notification, so a coarse
  # group_by silently dropped every other service's alert from analysis.
  group_by: ['alertname', 'severity', 'service', 'namespace', 'pod', 'node', 'instance']
  # 10s (default is 30s) -- first notification for a new alert group goes out
  # almost as soon as Prometheus fires it, so the demo email isn't held back
  # half a minute after the alert already shows in the UI.
  group_wait: 10s
  group_interval: 5m
  repeat_interval: 12h
  routes:
    - matchers:
        - severity = "critical"
      receiver: 'critical-webhook'
      repeat_interval: 1h
    - matchers:
        - severity = "warning"
      receiver: 'default-webhook'
      repeat_interval: 6h

receivers:
  - name: 'default-webhook'
    # Replace with your real endpoint — Slack, PagerDuty, SNS, etc.
    # Slack example (uncomment and set SLACK_WEBHOOK_URL):
    # slack_configs:
    #   - api_url: 'https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK'
    #     channel: '#bookstore-alerts'
    #     title: '[{{ .Status | toUpper }}] {{ .GroupLabels.alertname }}'
    #     text: '{{ range .Alerts }}{{ .Annotations.summary }}{{ "\n" }}{{ end }}'
    #     send_resolved: true
    webhook_configs:
      - url: '${rca_webhook_url}'
        send_resolved: true
    email_configs:
      - to: '$SMTP_TO'
        send_resolved: true
        headers:
          Subject: '[{{ .Status | toUpper }}] {{ .GroupLabels.alertname }}'

  - name: 'critical-webhook'
    webhook_configs:
      - url: '${rca_webhook_url}'
        send_resolved: true
    email_configs:
      - to: '$SMTP_TO'
        send_resolved: true
        headers:
          Subject: '[CRITICAL] {{ .GroupLabels.alertname }}'

inhibit_rules:
  - source_matchers:
      - severity = "critical"
    target_matchers:
      - severity = "warning"
    equal: ['alertname', 'instance']
  # A whole Deployment being down explains its unavailable replicas and
  # NotReady pods -- send the root alert, not three.
  - source_matchers:
      - alertname = "DeploymentDown"
    target_matchers:
      - alertname =~ "DeploymentReplicasUnavailable|PodNotReady|ServiceTargetDown"
    equal: ['namespace']
  - source_matchers:
      - alertname =~ "ContainerWaiting|PodCrashLooping|ContainerOOMKilled"
    target_matchers:
      - alertname = "PodNotReady"
    equal: ['namespace', 'pod']
  - source_matchers:
      - alertname =~ "NodeDown|KubeNodeNotReady|ChaosNodeDown|ChaosNodeNotReady"
    target_matchers:
      - alertname = "KubeNodeCountDecreased"
AM_EOF

# ── Alertmanager web auth (OBS-063) ───────────────────────────────────────────
# Same shared basic-auth credential as Prometheus's web.yml above --
# referenced by --web.config.file in the alertmanager service below.
cat > /opt/monitoring/alertmanager/web.yml << WEB_EOF
basic_auth_users:
  admin: $MONITORING_BASIC_AUTH_HASH
WEB_EOF

# ── Loki config ───────────────────────────────────────────────────────────────
cat > /opt/monitoring/loki/config.yaml << 'LOKI_EOF'
auth_enabled: false
server:
  http_listen_port: 3100
common:
  path_prefix: /loki
  storage:
    filesystem:
      chunks_directory: /loki/chunks
      rules_directory: /loki/rules
  replication_factor: 1
  ring:
    instance_addr: 127.0.0.1
    kvstore:
      store: inmemory
schema_config:
  configs:
    - from: 2020-10-24
      store: boltdb-shipper
      object_store: filesystem
      schema: v11
      index:
        prefix: index_
        period: 24h
limits_config:
  allow_structured_metadata: false
  retention_period: 336h

compactor:
  working_directory: /loki/compactor
  retention_enabled: true
  delete_request_store: filesystem

# Log-based alerts (rules below). Same Alertmanager, same basic auth as
# Prometheus; the password comes from the environment (-config.expand-env)
# so it never lands in this file.
ruler:
  storage:
    type: local
    local:
      directory: /etc/loki/rules
  rule_path: /loki/rules-temp
  alertmanager_url: http://alertmanager:9093
  enable_alertmanager_v2: true
  alertmanager_client:
    basic_auth_username: admin
    basic_auth_password: $${LOKI_ALERTMANAGER_PASSWORD}
  enable_api: true
LOKI_EOF

# ── Loki alert rules (log-based) ──────────────────────────────────────────────
# Loki has no service labels (Fluent Bit runs on the host, no k8s
# enrichment), so each rule pulls namespace/service out of the Fluent Bit
# `filename` field: .../<pod>_<namespace>_<container>-<64-hex id>.log.
# auth_enabled=false -> tenant "fake".
mkdir -p /opt/monitoring/loki/rules/fake
cat > /opt/monitoring/loki/rules/fake/bookstore.yml << 'LOKI_RULES_EOF'
groups:
  - name: bookstore-logs
    interval: 1m
    rules:
      - alert: DBErrorsInLogs
        expr: |
          sum by (namespace, service) (count_over_time({job="eks-containers"}
            |~ `db_error|ER_[A-Z_]{3,}|PROTOCOL_CONNECTION_LOST|Too many connections|rds\.amazonaws\.com`
            | regexp `_(?P<namespace>[a-z0-9-]+)_(?P<service>[a-z0-9-]+)-[0-9a-f]{64}\.log`
            | namespace =~ "catalog|user|order|notification|gateway" [5m])) > 3
        for: 1m
        labels: {severity: critical, source: loki}
        annotations:
          summary: "{{ $labels.service }} logging database errors ({{ $value }} in 5m)"
      - alert: UpstreamConnectionErrors
        expr: |
          sum by (namespace, service) (count_over_time({job="eks-containers"}
            |~ `ECONNREFUSED|ECONNRESET|ETIMEDOUT|socket hang up|TimeoutError|while proxying`
            | regexp `_(?P<namespace>[a-z0-9-]+)_(?P<service>[a-z0-9-]+)-[0-9a-f]{64}\.log`
            | namespace =~ "catalog|user|order|notification|gateway" [5m])) > 5
        for: 1m
        labels: {severity: warning, source: loki}
        annotations:
          summary: "{{ $labels.service }} failing to reach a dependency ({{ $value }} connection errors in 5m)"
      - alert: AppErrorLogSpike
        expr: |
          sum by (namespace, service) (count_over_time({job="eks-containers"}
            |~ `level\\":\\"error`
            | regexp `_(?P<namespace>[a-z0-9-]+)_(?P<service>[a-z0-9-]+)-[0-9a-f]{64}\.log`
            | namespace =~ "catalog|user|order|notification|gateway" [5m])) > 20
        for: 2m
        labels: {severity: warning, source: loki}
        annotations:
          summary: "{{ $labels.service }} error-level log spike ({{ $value }} in 5m)"
LOKI_RULES_EOF

# ── Grafana datasources ───────────────────────────────────────────────────────
# Unquoted heredoc (was quoted 'GRAFANA_DS_EOF' -- switched so
# $MONITORING_BASIC_AUTH_PASSWORD expands): Prometheus and Alertmanager both
# now require basic auth (OBS-063), so Grafana's own queries to them need
# the same credential or every dashboard panel breaks with a 401. This goes
# in secureJsonData (Grafana encrypts it at rest, same mechanism as any
# other datasource password), not jsonData.
cat > /opt/monitoring/grafana/provisioning/datasources/datasources.yaml << GRAFANA_DS_EOF
apiVersion: 1
datasources:
  - name: Prometheus
    type: prometheus
    uid: prometheus
    url: http://prometheus:9090
    isDefault: true
    editable: false
    basicAuth: true
    basicAuthUser: admin
    secureJsonData:
      basicAuthPassword: $MONITORING_BASIC_AUTH_PASSWORD
    jsonData:
      alertmanagerUid: alertmanager
  - name: Loki
    type: loki
    uid: loki
    url: http://loki:3100
    editable: false
  - name: Alertmanager
    type: alertmanager
    uid: alertmanager
    url: http://alertmanager:9093
    editable: false
    basicAuth: true
    basicAuthUser: admin
    secureJsonData:
      basicAuthPassword: $MONITORING_BASIC_AUTH_PASSWORD
    jsonData:
      implementation: prometheus
GRAFANA_DS_EOF

# ── Grafana dashboard provisioner config ──────────────────────────────────────
cat > /opt/monitoring/grafana/provisioning/dashboards/dashboards.yaml << 'DASH_PROV_EOF'
apiVersion: 1
providers:
  - name: default
    orgId: 1
    folder: Bookstore
    type: file
    disableDeletion: false
    updateIntervalSeconds: 30
    options:
      path: /etc/grafana/provisioning/dashboards
DASH_PROV_EOF

# ── Docker Compose ────────────────────────────────────────────────────────────
# Unquoted heredoc: $GRAFANA_PASSWORD is expanded by bash at write time
cat > /opt/monitoring/docker-compose.yml << COMPOSE_EOF
services:
  prometheus:
    image: prom/prometheus:v2.53.0
    container_name: prometheus
    ports:
      - "9090:9090"
    volumes:
      - /opt/monitoring/prometheus:/etc/prometheus
      - /opt/monitoring/kube:/etc/prometheus/kube:ro
      - prometheus_data:/prometheus
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.retention.time=15d'
      - '--web.enable-lifecycle'
      - '--web.config.file=/etc/prometheus/web.yml'
    restart: unless-stopped

  kube-state-metrics:
    image: registry.k8s.io/kube-state-metrics/kube-state-metrics:v2.13.0
    container_name: kube-state-metrics
    # user: "0:0" -- the image's own /root (baked in, not affected by the
    # host-side mount) is 0700, so the container's default non-root user
    # can't traverse into /root/.kube regardless of the mounted file's own
    # permissions. Running as root avoids fighting the image's own layout.
    user: "0:0"
    volumes:
      - /opt/monitoring/kube:/root/.kube:ro
    command:
      - '--kubeconfig=/root/.kube/config'
      # kube_node_labels{label_role="chaos"} -- lets node alerts tell the
      # Spot chaos group apart from app nodes.
      - '--metric-labels-allowlist=nodes=[role]'
    restart: unless-stopped

  loki:
    image: grafana/loki:3.0.0
    container_name: loki
    ports:
      - "3100:3100"
    volumes:
      - /opt/monitoring/loki/config.yaml:/etc/loki/config.yaml:ro
      - /opt/monitoring/loki/rules:/etc/loki/rules:ro
      - loki_data:/loki
    environment:
      - LOKI_ALERTMANAGER_PASSWORD=$MONITORING_BASIC_AUTH_PASSWORD
    command:
      - '-config.file=/etc/loki/config.yaml'
      - '-config.expand-env=true'
    restart: unless-stopped

  alertmanager:
    image: prom/alertmanager:v0.27.0
    container_name: alertmanager
    ports:
      - "9093:9093"
    volumes:
      - /opt/monitoring/alertmanager:/etc/alertmanager
      - alertmanager_data:/alertmanager
    command:
      - '--config.file=/etc/alertmanager/alertmanager.yml'
      - '--storage.path=/alertmanager'
      - '--web.external-url=http://localhost:9093'
      - '--web.config.file=/etc/alertmanager/web.yml'
    restart: unless-stopped

  grafana:
    image: grafana/grafana:11.0.0
    container_name: grafana
    ports:
      - "3000:3000"
    environment:
      - GF_SECURITY_ADMIN_PASSWORD=$GRAFANA_PASSWORD
      - GF_USERS_ALLOW_SIGN_UP=false
      - GF_AUTH_ANONYMOUS_ENABLED=false
    volumes:
      - /opt/monitoring/grafana/provisioning:/etc/grafana/provisioning:ro
      - grafana_data:/var/lib/grafana
    restart: unless-stopped
    depends_on:
      - prometheus
      - loki

volumes:
  prometheus_data:
  grafana_data:
  loki_data:
  alertmanager_data:
COMPOSE_EOF

# ── Start the stack ───────────────────────────────────────────────────────────
cd /opt/monitoring
docker compose up -d

# ── Import Grafana dashboards in background (after Grafana is healthy) ────────
cat > /usr/local/bin/import-grafana-dashboards.sh << 'IMPORT_EOF'
#!/bin/bash
set -euo pipefail
exec > /var/log/grafana-dashboard-import.log 2>&1

GRAFANA="http://localhost:3000"
PASS=$(cat /run/grafana-pass)
# This script runs as its own process (not the same shell as the main
# boot script above), so it re-reads the Prometheus basic-auth password
# from the file that script wrote (OBS-063), same pattern as PASS above.
PROM_PASS=$(cat /opt/monitoring/prometheus/basic-auth-password)

for i in $(seq 1 36); do
  curl -sf "$GRAFANA/api/health" 2>/dev/null | grep -q '"database": "ok"' && break
  echo "Waiting for Grafana... attempt $i"
  sleep 10
done

import_dash() {
  # Large dashboard JSON (e.g. #1860, ~683KB) blows Linux's 128KB per-arg
  # exec limit if passed inline to curl -d -- use -d @file instead. OBS-040.
  local id=$1 rev=$2 ds_input=$3
  local raw="/tmp/dash-$id.json"
  local payload="/tmp/payload-$id.json"
  if ! curl -sf "https://grafana.com/api/dashboards/$id/revisions/$rev/download" -o "$raw"; then
    echo "Failed to download dashboard $id"
    return 0
  fi
  python3 -c "
import json
d = json.load(open('$raw'))
payload = {'dashboard': d, 'overwrite': True, 'inputs': [{'name': '$ds_input', 'type': 'datasource', 'pluginId': 'prometheus', 'value': 'prometheus'}], 'folderId': 0}
json.dump(payload, open('$payload', 'w'))
"
  if ! curl -sf -X POST "$GRAFANA/api/dashboards/import" \
    -u "admin:$PASS" \
    -H "Content-Type: application/json" \
    -d "@$payload" > /dev/null; then
    echo "Failed to import dashboard $id"
    return 0
  fi
  echo "Imported Grafana dashboard $id (rev $rev)"
}

import_dash 1860 37 "DS_PROMETHEUS"  # Node Exporter Full

# Dashboard 1860's $job/$node template variables save with no default value
# (empty at import time, before Prometheus has scraped anything) and don't
# self-populate afterward -- every panel interpolates job="" and stays
# permanently empty even once real data exists, until something explicitly
# sets a value. UID is stable across imports (baked into the dashboard JSON
# itself by grafana.com), so it's safe to hardcode here.
for i in $(seq 1 12); do
  curl -sf -G -u "admin:$PROM_PASS" "http://localhost:9090/api/v1/query" --data-urlencode 'query=node_uname_info' \
    2>/dev/null | grep -q '"instance"' && break
  sleep 10
done
DASH_JSON=$(curl -sf -u "admin:$PASS" "$GRAFANA/api/dashboards/uid/rYdddlPWk")
NODE_INSTANCE=$(curl -sf -G -u "admin:$PROM_PASS" "http://localhost:9090/api/v1/query" --data-urlencode 'query=node_uname_info' \
  | python3 -c "import json,sys; print(json.load(sys.stdin)['data']['result'][0]['metric']['instance'])" 2>/dev/null || echo "")
if [ -n "$NODE_INSTANCE" ]; then
  echo "$DASH_JSON" | python3 -c "
import json, sys
d = json.load(sys.stdin)['dashboard']
for v in d.get('templating', {}).get('list', []):
    if v['name'] == 'job':
        v['current'] = {'text': 'node-exporter', 'value': 'node-exporter'}
    if v['name'] == 'node':
        v['current'] = {'text': '$NODE_INSTANCE', 'value': '$NODE_INSTANCE'}
json.dump({'dashboard': d, 'overwrite': True, 'folderId': 0}, open('/tmp/node-exporter-fix.json', 'w'))
"
  curl -sf -X POST "$GRAFANA/api/dashboards/db" -u "admin:$PASS" \
    -H "Content-Type: application/json" -d @/tmp/node-exporter-fix.json > /dev/null \
    && echo "Fixed Node Exporter Full's stuck job/node variables" \
    || echo "Failed to fix Node Exporter Full variables"
fi

# Dashboard 315 ("Kubernetes cluster monitoring") is dropped -- its $Node
# variable queries the label `kubernetes_io_hostname`, which doesn't exist
# anywhere in this Prometheus at all (confirmed: zero matching series), a
# real convention mismatch with this kube-state-metrics/cAdvisor setup, not
# an import-timing artifact. Replaced by a small custom dashboard below,
# built against metrics this setup actually exposes.
cat > /opt/monitoring/grafana/provisioning/dashboards/pod-node-resources.json << 'CUSTOM_DASH_EOF'
${custom_dashboard_json}
CUSTOM_DASH_EOF

# Cluster-wide view (nodes/pods/deployments/alerts) alongside the per-pod
# resource dashboard above -- same file-provisioning approach, no API call.
cat > /opt/monitoring/grafana/provisioning/dashboards/k8s-cluster-overview.json << 'CLUSTER_DASH_EOF'
${cluster_dashboard_json}
CLUSTER_DASH_EOF

echo "Dashboard import complete"
IMPORT_EOF

chmod +x /usr/local/bin/import-grafana-dashboards.sh
nohup /usr/local/bin/import-grafana-dashboards.sh &
